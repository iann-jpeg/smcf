# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/smcf-sacco?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d

# CORS Configuration
FRONTEND_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ─── Email Verification (Resend API) ───────────────────────────────────────
# Get your API key from https://resend.com
RESEND_API_KEY=your-resend-api-key

# ─── Lipia Online (M-Pesa STK Push → Till 6938069) ───────────────────────────
# Obtainable from your Lipia Online dashboard at kreativelabske.com
LIPIA_API_KEY=your-lipia-api-key
LIPIA_API_URL=https://lipia-api.kreativelabske.com/api/v2
LIPIA_APP_ID=your-lipia-app-id
LIPIA_APP_NAME=your-lipia-app-name

# Public URL Lipia will POST payment results back to (must be HTTPS and reachable by Lipia)
MPESA_CALLBACK_URL=https://smcf-sacco-backend.onrender.com/api/mpesa/callback

# ─── Admin Notifications ───────────────────────────────────────
# Comma-separated list of admin email addresses to receive system activity notifications
ADMIN_EMAILS=ianabungana5@gmail.com

