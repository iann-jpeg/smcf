# ====================================
# DEPLOYMENT NOTE
# ====================================
# This app is built with base=/sacco/ and served under smcf.app/sacco/
# by the same Vercel project as the main SMCF app. You do NOT deploy
# this folder separately — it is built via "npm run build:sacco" from
# the parent smcf/ directory and output lands in smcf/dist/sacco/.
#
# Set these env vars in the Vercel project dashboard (smcf.app):
#   VITE_SACCO_API_URL      → /sacco-api
#   VITE_SMCF_PAYMENT_URL   → https://<main-smcf-backend>.onrender.com/api
#   VITE_SMCF_API_KEY       → (value of SACCO_API_KEY on main backend)
#
# NOTE: VITE_SACCO_API_URL (not VITE_API_URL) is used here to avoid
# collision with the main smcf app's VITE_API_URL in the same Vercel project.
# ====================================

# SACCO backend gateway base (members, loans, savings, auth)
# Final request pattern becomes: /sacco-api/api/*
VITE_SACCO_API_URL=/sacco-api

# For production (set in Vercel dashboard, not here):
# VITE_SACCO_API_URL=/sacco-api

# SMCF Main Backend — Shared Payment API (Lipia / M-Pesa)
VITE_SMCF_PAYMENT_URL=http://localhost:4000/api
VITE_SMCF_API_KEY=smcf-sacco-bridge-2026-secure

# For production (set in Vercel dashboard, not here):
# VITE_SMCF_PAYMENT_URL=https://<main-smcf-backend>.onrender.com/api

# ─── Push Notifications - VAPID Keys ───────────────────────────────────────
VITE_VAPID_PUBLIC_KEY=BISgKVrTV-OdFzVEaxt4ugMbIk-dbEQW22ESUfqQomeZURsV5fIq3CToWmjb-j2jW4f5dgL3VHdGLkmTxTlwoUU
# VITE_SMCF_API_KEY=<same value as SACCO_API_KEY on main backend>
