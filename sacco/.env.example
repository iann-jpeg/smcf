# ====================================
# DEPLOYMENT NOTE
# ====================================
# This app defaults to base=/sacco/ and can be served under
# smart-moves.tech/sacco/. For a SACCO-only root-domain deployment, set
# VITE_SACCO_BASE_PATH=/ before building and serve sacco/dist at the domain root.
# You do NOT deploy
# this folder separately â€” it is built via "npm run build:sacco" from
# the parent smcf/ directory and output lands in smcf/dist/sacco/.
#
# Set these env vars in the Vercel project dashboard (smart-moves.tech):
#   VITE_SACCO_API_URL      â†’ /sacco-api
#   VITE_SMCF_PAYMENT_URL   â†’ https://<main-smcf-backend>.onrender.com/api
#   The main SMCF message bridge is server-side only; no browser API key is required.
#
# NOTE: VITE_SACCO_API_URL (not VITE_API_URL) is used here to avoid
# collision with the main smcf app's VITE_API_URL in the same Vercel project.
# ====================================

# SACCO backend gateway base (members, loans, savings, auth)
# Final request pattern becomes: /sacco-api/api/*
VITE_SACCO_API_URL=/sacco-api
VITE_SACCO_BASE_PATH=/

# For production (set in Vercel dashboard, not here):
# VITE_SACCO_API_URL=/sacco-api

# SMCF Main Backend â€” Shared Payment API (Lipia / M-Pesa)
VITE_SMCF_PAYMENT_URL=http://localhost:4000/api

# For production (set in Vercel dashboard, not here):
# VITE_SMCF_PAYMENT_URL=https://<main-smcf-backend>.onrender.com/api

