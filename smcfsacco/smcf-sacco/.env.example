# Backend API URL
VITE_API_URL=http://localhost:5000/api

# Preferred SACCO backend URL (used by API client when present)
VITE_SACCO_API_URL=http://localhost:5000/api

# Main SMCF bridge (for showing Main SMCF member messages inside SACCO admin inbox)
# You can use either pair below (both are supported):
VITE_MAIN_SMCF_API_URL=http://localhost:4000
VITE_MAIN_SMCF_BRIDGE_KEY=your-bridge-key

# Backward-compatible aliases used in some deployments
VITE_SMCF_PAYMENT_URL=http://localhost:4000/api
VITE_SMCF_API_KEY=your-bridge-key

# For production deployment, update with your backend URL:
# VITE_SACCO_API_URL=https://your-sacco-backend.onrender.com/api

