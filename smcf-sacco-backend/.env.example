# Server Configuration
PORT=5001
NODE_ENV=production

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/smcf-sacco?retryWrites=true&w=majority

# JWT Configuration
# Required; minimum 32 random characters. Startup/auth fail closed when absent.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRE=7d

# CORS Configuration
FRONTEND_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
# Auth login rate limiting (development overrides)
# RATE_LIMIT_AUTH_LOGIN_MAX=1000
# RATE_LIMIT_AUTH_LOGIN_DISABLED=true

# ─── Email Verification (Resend API) ───────────────────────────────────────
# Get your API key from https://resend.com
RESEND_API_KEY=your-resend-api-key
# Use a verified sender on Resend. During setup you can use onboarding@resend.dev
# and later switch to your own verified domain address, e.g. noreply@smcfsacco.co.ke
RESEND_FROM_EMAIL=SMCF SACCO <onboarding@resend.dev>
# Disabled by default; reset/verification tokens are never returned in public responses.
ALLOW_EMAIL_TOKEN_FALLBACK=false

# Required out-of-band secret for the one-time admin bootstrap endpoint (minimum 32 characters).
ADMIN_BOOTSTRAP_SECRET=
# Required provider callback header secret. Configure the provider/proxy to send
# X-Payment-Callback-Secret; callbacks are rejected when this is absent or invalid.
PAYMENT_CALLBACK_SECRET=

# ─── PayHero (M-Pesa STK Push) ───────────────────────────────────────────────
PAYHERO_API_URL=https://backend.payhero.co.ke
PAYHERO_API_USERNAME=
PAYHERO_API_PASSWORD=
PAYHERO_VENDOR_ID=
# Route collections through the configured dashboard channel.
PAYHERO_PAYMENT_MODE=channel
# Active Till channel from the PayHero dashboard.
PAYHERO_CHANNEL_ID=13420
# PayHero account resource ID for the channel (not the Till number).
PAYHERO_ACCOUNT_ID=
# Receiving Till number shown in the PayHero dashboard, for operator diagnostics.
PAYHERO_TILL_NUMBER=6938069
PAYHERO_CALLBACK_URL=https://smcf.app/sacco/api/mpesa/payhero/callback

# ─── Pesapal (card payments; optional until card credentials are available) ──
# Sandbox API 3.0: https://cybqa.pesapal.com/pesapalv3/api
# Production API 3.0: https://pay.pesapal.com/v3
PESAPAL_BASE_URL=https://cybqa.pesapal.com/pesapalv3/api
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_CALLBACK_URL=https://smcf.app/sacco/api/pesapal/callback
PESAPAL_IPN_ID=

# ─── Admin Notifications ───────────────────────────────────────
# Comma-separated list of admin email addresses to receive system activity notifications
# Example: admin1@example.com,admin2@example.com
ADMIN_EMAILS=ianabungana5@gmail.com

# ─── Push Notifications - VAPID Keys ───────────────────────────────────────
VAPID_PRIVATE_KEY=replace-with-server-only-vapid-private-key
VAPID_PUBLIC_KEY=BISgKVrTV-OdFzVEaxt4ugMbIk-dbEQW22ESUfqQomeZURsV5fIq3CToWmjb-j2jW4f5dgL3VHdGLkmTxTlwoUU
