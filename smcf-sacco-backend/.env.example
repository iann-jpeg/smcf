# Server Configuration
PORT=5001
NODE_ENV=production

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/smcf-sacco?retryWrites=true&w=majority

# JWT Configuration
# Required; minimum 32 random characters. Startup/auth fail closed when absent.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRE=7d

# CORS Configuration
FRONTEND_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
# Auth login rate limiting (development overrides)
# RATE_LIMIT_AUTH_LOGIN_MAX=1000
# RATE_LIMIT_AUTH_LOGIN_DISABLED=true

# â”€â”€â”€ Email Verification (Resend API) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Get your API key from https://resend.com
RESEND_API_KEY=your-resend-api-key
# Use a verified sender on Resend. During setup you can use onboarding@resend.dev
# and later switch to your own verified domain address, e.g. noreply@smcfsacco.co.ke
RESEND_FROM_EMAIL=SMCF SACCO <onboarding@resend.dev>
# Disabled by default; reset/verification tokens are never returned in public responses.
ALLOW_EMAIL_TOKEN_FALLBACK=false

# Required out-of-band secret for the one-time admin bootstrap endpoint (minimum 32 characters).
ADMIN_BOOTSTRAP_SECRET=
# Only required if an older normalized callback adapter uses
# /api/mpesa/legacy-daraja/callback. Safaricom Daraja native callbacks do not
# send this header and use /api/mpesa/daraja/callback instead.
# PAYMENT_CALLBACK_SECRET=

# â”€â”€â”€ Safaricom Daraja (M-Pesa STK Push) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
DARAJA_API_URL=https://api.safaricom.co.ke
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_TILL_NUMBER=
DARAJA_PASSKEY=
DARAJA_CALLBACK_URL=https://smart-moves.tech/sacco-api/api/mpesa/daraja/callback
# Legacy aliases are still accepted for compatibility during migration.
# MPESA_API_URL=
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
# MPESA_CALLBACK_URL=

# â”€â”€â”€ Pesapal (card payments; optional until card credentials are available) â”€â”€
# Sandbox API 3.0: https://cybqa.pesapal.com/pesapalv3/api
# Production API 3.0: https://pay.pesapal.com/v3
PESAPAL_BASE_URL=https://cybqa.pesapal.com/pesapalv3/api
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_CALLBACK_URL=https://smart-moves.tech/sacco/api/pesapal/callback
PESAPAL_IPN_ID=

# â”€â”€â”€ Admin Notifications â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Comma-separated list of admin email addresses to receive system activity notifications
# Example: admin1@example.com,admin2@example.com
ADMIN_EMAILS=ianabungana5@gmail.com

