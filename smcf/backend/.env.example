# MongoDB Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/smcf?retryWrites=true&w=majority

# Server Configuration
PORT=4000
NODE_ENV=production
CLIENT_URL=https://smcf.app

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Admin Configuration
ADMIN_PHONE=254759097157

# Cross-app bridge key for SACCO admin inbox integration
# Must match SACCO frontend bridge key (VITE_MAIN_SMCF_BRIDGE_KEY or VITE_SMCF_API_KEY)
SACCO_BRIDGE_KEY=your-bridge-key

# Lipia Online Payment Gateway Configuration
LIPIA_API_KEY=your_lipia_api_key_here
LIPIA_APP_ID=your_lipia_app_id_here
LIPIA_APP_NAME=smcf
LIPIA_APP_TYPE=TILL
LIPIA_API_URL=https://lipia-api.kreativelabske.com/api/v2

# Admin Notifications
# Comma-separated list of admin email addresses to receive system activity notifications
ADMIN_EMAILS=admin@example.com

# Push Notifications - VAPID Keys
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_PUBLIC_KEY=your_vapid_public_key
