# Cross-app bridge key for SACCO admin inbox integration
# Must match SACCO frontend bridge key (VITE_MAIN_SMCF_BRIDGE_KEY or VITE_SMCF_API_KEY)
SACCO_BRIDGE_KEY=your-bridge-key

# SACCO backend proxy target (used by /sacco-api/* route)
# For same VPS host: http://127.0.0.1:5000
SACCO_BACKEND_URL=http://127.0.0.1:5000

# Optional fallback target if primary SACCO_BACKEND_URL is unavailable.
# Leave empty for VPS-only deployments to avoid external/WAF CAPTCHA paths.
SACCO_BACKEND_FALLBACK_URL=

